---
const year = new Date().getFullYear();
const links = [
  { href: "/projects/", label: "Work" },
  { href: "/blog/", label: "Writing" },
  { href: "/about/", label: "About" },
  { href: "/resume/", label: "Résumé" },
  { href: "/contact/", label: "Contact" },
];
---

<footer class="site-footer mt-20">
  <div class="site-footer-accent" aria-hidden="true"></div>
  <div class="container mx-auto grid gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.3fr_1fr_1fr] md:py-16">
    <div>
      <a href="/" class="flex w-fit items-center gap-3" aria-label="Teri Eyenike, home">
        <span class="site-footer-monogram grid h-11 w-11 place-items-center font-mono text-sm font-bold" aria-hidden="true">TE.</span>
        <span class="text-lg font-bold">Teri Eyenike</span>
      </a>
      <p class="mt-4 max-w-sm text-sm leading-6 opacity-75">Software projects and clear technical writing. Based in Nigeria, working everywhere.</p>
    </div>

    <nav aria-label="Footer navigation">
      <h2 class="site-kicker mb-4 opacity-90">Explore</h2>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
        {links.map((link) => <li><a class="site-footer-link" href={link.href}>{link.label}</a></li>)}
        <li><a class="site-footer-link" href="/tags/">Topics</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="site-kicker mb-4 opacity-90">Say hello</h2>
      <a class="site-footer-link text-sm" href="mailto:developedbyteri@gmail.com">developedbyteri@gmail.com</a>
      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <a class="site-footer-link" href="https://github.com/terieyenike" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a class="site-footer-link" href="https://www.linkedin.com/in/terieyenike" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a class="site-footer-link" href="/rss.xml">RSS ↗</a>
      </div>
      <div class="mt-4 border-t border-white/15 pt-3 text-sm">
        <a class="site-footer-link" href="https://www.buymeacoffee.com/eyenike" target="_blank" rel="noopener noreferrer">Support my work ↗</a>
      </div>
    </div>
  </div>
  <div class="container mx-auto flex flex-col gap-2 border-t px-4 py-5 text-xs opacity-90 sm:flex-row sm:items-center sm:justify-between sm:px-6" style="border-color:color-mix(in srgb,var(--paper) 35%,transparent)">
    <span>© {year} Teri Eyenike</span>
    <span>Made with care in Nigeria · Built with Astro</span>
  </div>
</footer>

<style is:global>
  .site-footer { background: var(--ink); color: var(--paper); }
  .site-footer-accent { height: 5px; background: var(--acid); }
  .site-footer-monogram { background: var(--acid); color: #171b16; }
  .site-footer-link { color: inherit; text-decoration-color: var(--acid); text-underline-offset: 4px; }
  .site-footer-link:hover { color: var(--acid); text-decoration: underline; }
  .dark .site-footer-link:hover { color: #506814; text-decoration-color: #506814; }
  .site-footer > .container:last-child { border-color: color-mix(in srgb, var(--paper) 22%, transparent); }
</style>
