---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../../styles/global.css";
import Favicon from "@src/assets/img/favicon.png";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  pageSchema?: Record<string, unknown>;
  noIndex?: boolean;
  pageType?: "website" | "article";
}

const {
  title = "Software Engineer | Teri Eyenike",
  description = SITE_DESCRIPTION,
  image = "https://res.cloudinary.com/terieyenike/image/upload/v1748796012/teri_eyenike_skwuyb.png",
  canonicalUrl,
  pageSchema,
  noIndex = false,
  pageType = "website",
} = Astro.props;

const siteRoot = new URL("/", Astro.site || Astro.url).href;
const personId = `${siteRoot}#person`;
const finalCanonicalURL = canonicalUrl ? new URL(canonicalUrl) : new URL(Astro.url.pathname, siteRoot);
const imageUrl = new URL(image, siteRoot).href;
const siteGraph = [
  {
    "@type": "WebSite",
    "@id": `${siteRoot}#website`,
    url: siteRoot,
    name: SITE_TITLE,
    description: SITE_DESCRIPTION,
    inLanguage: "en-NG",
    about: { "@id": personId },
    publisher: { "@id": personId },
  },
  {
    "@type": "Person",
    "@id": personId,
    name: "Teri Eyenike",
    url: siteRoot,
    image: imageUrl,
    jobTitle: "Software Engineer",
    description: SITE_DESCRIPTION,
    email: "developedbyteri@gmail.com",
    knowsAbout: [
      "Software engineering",
      "Web application development",
      "Developer tools",
      "Technical writing",
      "Consulting",
      "PostgreSQL",
    ],
    sameAs: [
      "https://github.com/Terieyenike",
      "https://www.linkedin.com/in/terieyenike",
      "https://x.com/_terieyenike",
      "https://www.instagram.com/terieyenike",
      "https://www.youtube.com/@terieyenike",
    ],
  },
  ...(pageSchema ? [pageSchema] : []),
];
const structuredData = JSON.stringify({ "@context": "https://schema.org", "@graph": siteGraph }).replace(/</g, "\\u003c");
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href={Favicon.src} />
<script is:inline>
  (() => {
    const loadSabilytics = () => {
      if (document.querySelector("script[data-sabilytics]")) return;
      const script = document.createElement("script");
      script.async = true;
      script.src = "https://www.sabilytics.com/script.js";
      script.dataset.sabilytics = "true";
      script.dataset.site = "ylyeqns7l7hy";
      script.dataset.domain = "iamteri.tech";
      document.head.append(script);
    };

    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(loadSabilytics, { timeout: 3000 });
    } else {
      window.addEventListener("load", () => window.setTimeout(loadSabilytics, 1200), { once: true });
    }
  })();
</script>
<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS feed`} href="/rss.xml" />
<link rel="describedby" href="/llms.txt" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={finalCanonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Teri Eyenike" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={pageType} />
<meta property="og:locale" content="en_NG" />
<meta property="og:url" content={finalCanonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={finalCanonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageUrl} />
<meta property="twitter:image:alt" content={description} />
<meta name="twitter:creator" content="@terieyenike" />

<!-- Additional Meta Tags -->
<meta name="theme-color" content="#F4F2E9" />
<meta name="robots" content={noIndex ? "noindex,follow" : "index,follow,max-image-preview:large"} />

<!-- Structured Data -->
<script is:inline type="application/ld+json" set:html={structuredData} />
