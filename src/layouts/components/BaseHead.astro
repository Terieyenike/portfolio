---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../../styles/global.css";
import Favicon from "@src/assets/img/favicon.png";
import { SITE_TITLE } from "../../consts";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = "Software & DevOps Engineer | Teri Eyenike",
  description = "Teri Eyenike builds software, developer tools, and cloud workflows, and writes practical technical guides.",
  image = "https://res.cloudinary.com/terieyenike/image/upload/v1748796012/teri_eyenike_skwuyb.png",
  canonicalUrl,
} = Astro.props;

// Use the provided canonical URL or generate one from the current path
const finalCanonicalURL = canonicalUrl
  ? new URL(canonicalUrl)
  : new URL(Astro.url.pathname, Astro.site);

// Generate structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Teri Eyenike",
  jobTitle: "Software and DevOps Engineer",
  url: Astro.site,
  image: new URL(image, Astro.url),
  description: description,
  knowsAbout: ["Software engineering", "DevOps", "Cloud computing", "PostgreSQL", "Developer tools", "Technical writing"],
  sameAs: [
    "https://github.com/terieyenike",
    "https://linkedin.com/in/terieyenike",
    "https://x.com/terieyenike",
    "https://www.instagram.com/terieyenike",
    "https://www.youtube.com/@terieyenike",
  ],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href={Favicon.src} />
<script
  is:inline
  async
  src="https://www.sabilytics.com/script.js"
  data-site="ylyeqns7l7hy"
  data-domain="iamteri.tech"
></script>
<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS feed`} href="/rss.xml" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={finalCanonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Teri Eyenike" />
<meta
  name="keywords"
  content="software engineer, DevOps engineer, cloud computing, developer tools, AWS, JavaScript, Node.js, Python, PostgreSQL, technical writing, open source"
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={finalCanonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta
  property="og:site_name"
  content="Teri Eyenike | Software, systems & stories"
/>

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={finalCanonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
<meta name="twitter:creator" content="@terieyenike" />

<!-- Additional Meta Tags -->
<meta name="theme-color" content="#F4F2E9" />
<meta name="robots" content="index, follow" />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
