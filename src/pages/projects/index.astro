---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getProjects } from './projects';

const projects = await getProjects();
const featured = projects.filter((project) => project.featured);
const others = projects.filter((project) => !project.featured);
---

<BaseLayout
  title="Projects | Teri Eyenike — Software, Cloud & DevOps"
  description="Explore Teri Eyenike’s software projects, including the Xata hackathon-winning Waitlist App, the Track Trips travel journal, a team-built shopping list, and a Python tool published on PyPI."
>
  <main class="container mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <header class="mb-14 max-w-3xl">
      <p class="site-kicker text-[var(--olive)]">Selected work / 01</p>
      <h1 class="mt-3 mb-4 text-5xl font-semibold tracking-tight text-[var(--ink)] sm:text-6xl">Projects</h1>
      <p class="text-lg leading-8 text-[var(--muted)]">
        A selection of tools, applications, and learning resources I have built. Each project links to its live page or source repository.
      </p>
    </header>

    {featured.length > 0 && (
      <section class="mb-14" aria-labelledby="featured-projects">
        <h2 id="featured-projects" class="site-kicker mb-4 text-[var(--olive)]">Featured projects</h2>
        <ProjectList projects={featured} />
      </section>
    )}

    {others.length > 0 && (
      <section aria-labelledby="more-projects">
        <h2 id="more-projects" class="site-kicker mb-4 text-[var(--olive)]">More projects</h2>
        <ProjectList projects={others} />
      </section>
    )}
  </main>
</BaseLayout>
