---
import BaseLayout from "../layouts/BaseLayout.astro";
import { experience, education, focusAreas } from "../data/resume";
import { publications } from "../data/publications";
import { getProjects } from "./projects/projects";

const projects = await getProjects();
const featuredProjects = projects.filter((project) => project.featured);
---

<BaseLayout
  title="Résumé | Teri Eyenike, Software Engineer & Developer Advocate"
  description="Software engineer and developer advocate Teri Eyenike’s experience, education, selected projects, technical skills, and publications."
>
  <main class="container mx-auto max-w-4xl px-4 py-12">
    <header class="mb-8 flex flex-col gap-5 border-b border-[var(--line)] pb-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="site-kicker mb-2 text-[var(--olive)]">Professional profile</p>
        <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-white">Teri Eyenike</h1>
        <p class="mt-2 text-lg text-zinc-600 dark:text-zinc-300">Software Engineer · Developer Advocate</p>
      </div>
      <button id="print-resume" type="button" class="rounded-none bg-[var(--ink)] px-5 py-3 font-semibold text-[var(--paper)] transition hover:bg-[var(--olive)] focus:outline-none focus:ring-2 focus:ring-[#D8F16A] focus:ring-offset-2">
        Print / Save as PDF
      </button>
    </header>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(220px,1fr)]">
      <div class="space-y-10">
        <section aria-labelledby="summary-title">
          <h2 id="summary-title" class="mb-3 text-xl font-bold text-zinc-900 dark:text-white">Profile</h2>
          <p class="leading-7 text-zinc-700 dark:text-zinc-300">I’m a software engineer and developer advocate who builds software and creates technical content that makes complex technologies accessible to developers. My experience spans frontend engineering, developer education, technical writing, community engagement, and full-stack development.</p>
        </section>

        {experience.length > 0 && <section aria-labelledby="experience-title">
          <h2 id="experience-title" class="mb-3 text-xl font-bold text-zinc-900 dark:text-white">Experience</h2>
          <div class="space-y-6">
              {experience.map((entry) => (
                <article class="border-l-2 border-[#506814] dark:border-[#D8F16A] pl-4">
                  <h3 class="font-semibold text-zinc-900 dark:text-white">{entry.title}</h3>
                  <p class="text-sm text-zinc-600 dark:text-zinc-400">{entry.organization} · {entry.dates}</p>
                  <ul class="mt-2 list-disc space-y-1 pl-5 text-zinc-700 dark:text-zinc-300">
                    {entry.details.map((detail) => <li>{detail}</li>)}
                  </ul>
                </article>
              ))}
          </div>
        </section>}

        <section aria-labelledby="projects-title">
          <h2 id="projects-title" class="mb-4 text-xl font-bold text-zinc-900 dark:text-white">Selected projects</h2>
          <div class="space-y-5">
            {featuredProjects.map((project) => (
              <article>
                <h3 class="font-semibold text-zinc-900 dark:text-white">{project.repositoryUrl || project.demoLink ? <a href={project.repositoryUrl || project.demoLink} target="_blank" rel="noopener noreferrer" class="underline decoration-[#667F20] underline-offset-4">{project.name}</a> : project.name}</h3>
                <p class="mt-1 text-zinc-700 dark:text-zinc-300">{project.description}</p>
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{project.tags.join(" · ")}</p>
                {project.outcome && <p class="mt-1 text-sm text-zinc-700 dark:text-zinc-300">{project.outcome}</p>}
              </article>
            ))}
          </div>
        </section>

        {education.length > 0 && <section aria-labelledby="education-title">
          <h2 id="education-title" class="mb-3 text-xl font-bold text-zinc-900 dark:text-white">Education &amp; certifications</h2>
          <div class="space-y-4">
              {education.map((entry) => (
                <article>
                  <h3 class="font-semibold text-zinc-900 dark:text-white">{entry.title}</h3>
                  <p class="text-sm text-zinc-600 dark:text-zinc-400">{entry.organization} · {entry.dates}</p>
                  {entry.details.map((detail) => <p class="mt-1 text-zinc-700 dark:text-zinc-300">{detail}</p>)}
                </article>
              ))}
          </div>
        </section>}

        <section aria-labelledby="writing-title">
          <h2 id="writing-title" class="mb-3 text-xl font-bold text-zinc-900 dark:text-white">Selected writing</h2>
          <ul class="space-y-3">
            {publications.map((publication) => (
              <li>
                <a class="font-medium text-[#506814] underline decoration-[#667F20] underline-offset-4 dark:text-[#D8F16A]" href={publication.url} target="_blank" rel="noopener noreferrer">{publication.title}</a>
                <span class="ml-2 text-sm text-zinc-600 dark:text-zinc-400">{publication.publication}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <aside class="space-y-8 border-t border-[var(--line)] pt-6 lg:border-l lg:border-t-0 lg:pl-6 lg:pt-0">
        <section aria-labelledby="contact-title">
          <h2 id="contact-title" class="mb-3 text-lg font-bold text-zinc-900 dark:text-white">Contact</h2>
          <ul class="space-y-2 text-sm text-zinc-700 dark:text-zinc-300">
            <li>Nigeria · WAT (UTC+1)</li>
            <li><a class="underline decoration-[#667F20] underline-offset-4" href="mailto:teri.eyenike@gmail.com">teri.eyenike@gmail.com</a></li>
            <li><a class="underline decoration-[#667F20] underline-offset-4" href="https://www.linkedin.com/in/terieyenike" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
            <li><a class="underline decoration-[#667F20] underline-offset-4" href="https://github.com/terieyenike" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          </ul>
        </section>
        <section aria-labelledby="focus-title">
          <h2 id="focus-title" class="mb-3 text-lg font-bold text-zinc-900 dark:text-white">Areas of focus</h2>
          <ul class="flex flex-wrap gap-2">
            {focusAreas.map((area) => <li class="rounded-full border border-[var(--line)] bg-zinc-100 px-3 py-1 text-sm text-zinc-700 dark:bg-zinc-800 dark:text-zinc-200">{area}</li>)}
          </ul>
        </section>
        <p class="text-sm text-zinc-600 dark:text-zinc-400">More work and writing at <a class="underline decoration-[#667F20] underline-offset-4" href="https://iamteri.tech">iamteri.tech</a>.</p>
      </aside>
    </div>
  </main>
</BaseLayout>

<script>
  document.getElementById("print-resume")?.addEventListener("click", () => window.print());
</script>

<style>
  @media print {
    @page { margin: 14mm; }
    :global(body) { background: white !important; color: #18181b !important; padding-top: 0 !important; }
    :global(#main-content) { min-height: 0 !important; padding: 0 !important; }
    :global(header#site-header), :global(footer), :global(#back-to-top), #print-resume { display: none !important; }
    main { max-width: none !important; padding: 0 !important; }
    main, main * { color: #18181b !important; }
    a { text-decoration: none !important; }
    section, article { break-inside: avoid; }
  }
</style>
