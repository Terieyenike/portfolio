---
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Teri from "@src/assets/img/teri.png";
import { getProjects } from "./projects/projects";
import ProjectList from "../components/ProjectList.astro";
import PostItem from "../components/PostItem.astro";
import { publications } from "../data/publications";

type BlogPost = CollectionEntry<"blog">;
const projects = await getProjects();
const featuredProjects = projects.filter((project) => project.featured).slice(0, 3);
const posts = (await getCollection("blog"))
  .sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={`${SITE_TITLE} | Software Engineer`} description={SITE_DESCRIPTION}>
  <main class="site-home mx-auto max-w-6xl px-4 sm:px-6">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-copy">
        <p class="site-kicker text-[var(--olive)]">Open to software engineering roles and collaboration <span class="mx-2 text-[var(--muted)]">/</span> Nigeria</p>
        <h1 id="home-title">Software engineer building useful web products.</h1>
        <p class="home-intro">I’m Teri Eyenike, a software engineer in Nigeria. I build web pages, applications, and developer tools. I also collaborate with teams on technical writing and consulting.</p>
        <div class="home-actions">
          <a class="button-primary" href="/projects/">Explore my work <span aria-hidden="true">↗</span></a>
          <a class="button-text" href="/contact/">Hire or collaborate <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="home-portrait-wrap">
        <div class="portrait-frame"><Image src={Teri} alt="Teri Eyenike on a boat in Ganvié, Benin Republic" width={520} loading="eager" class="home-portrait" /></div>
        <span class="portrait-index site-kicker">PERSONAL FIELD NOTES <b>№ 01</b></span>
        <span class="portrait-stamp" aria-hidden="true">TE<span>.</span></span>
      </div>
    </section>

    <section class="home-section" aria-labelledby="work-title">
      <header class="section-heading"><div><p class="site-kicker text-[var(--olive)]">01 / Things made</p><h2 id="work-title">Selected work</h2></div><a class="button-text" href="/projects/">All projects <span aria-hidden="true">↗</span></a></header>
      <ProjectList projects={featuredProjects} />
    </section>

    {publications.length > 0 && <section class="home-section" aria-labelledby="published-title">
      <header class="section-heading"><div><p class="site-kicker text-[var(--olive)]">02 / Elsewhere</p><h2 id="published-title">Published writing</h2></div></header>
      <div class="publication-list">
        {publications.slice(0, 3).map((work, index) => <a class="publication-row" href={work.url} target="_blank" rel="noopener noreferrer"><span class="publication-number">0{index + 1}</span><span><strong>{work.title}</strong><small>{work.publication || work.description}</small></span><span class="publication-arrow" aria-hidden="true">↗</span></a>)}
      </div>
    </section>}

    <section class="home-section" aria-labelledby="writing-title">
      <header class="section-heading"><div><p class="site-kicker text-[var(--olive)]">03 / In progress</p><h2 id="writing-title">Notes from the work</h2></div><a class="button-text" href="/blog/">All writing <span aria-hidden="true">↗</span></a></header>
      <div class="grid gap-5 md:grid-cols-2">{posts.map((post: BlogPost) => <PostItem post={post} />)}</div>
    </section>
    <section class="home-contact site-grid-pattern" aria-labelledby="contact-title"><div><p class="site-kicker text-[var(--olive)]">Have a good problem?</p><h2 id="contact-title">Let’s make something useful.</h2></div><a class="button-primary" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a></section>
  </main>
</BaseLayout>

<style>
  .site-home { padding-top: 1rem; }
  .home-hero { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: clamp(2rem, 7vw, 7rem); padding: clamp(2rem, 6vw, 5rem) 0 clamp(4rem, 10vw, 8rem); }
  .home-hero > * { min-width: 0; }
  .home-copy h1 { max-width: 760px; margin: 1.4rem 0 1.5rem; font-size: clamp(3.2rem, 7.2vw, 6.8rem); line-height: .98; font-weight: 650; letter-spacing: -.075em; }
  .home-copy h1 em { color: var(--olive); font-family: Georgia, "Times New Roman", serif; font-weight: 400; }
  .home-intro { max-width: 36rem; color: var(--muted); font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.75; }
  .home-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 2rem; }
  .button-primary, .button-text { display: inline-flex; align-items: center; gap: .8rem; text-decoration: none; font-weight: 650; }
  .button-primary { padding: .95rem 1.2rem; background: var(--ink); color: var(--paper); }
  .button-primary:hover { background: var(--olive); color: #fff; }
  .button-text { color: var(--ink); border-bottom: 1px solid var(--line); padding: .6rem 0; }
  .button-text:hover { color: var(--olive); border-color: var(--olive); }
  .home-meta { border-top: 1px solid var(--line); margin-top: 3rem; padding-top: 1rem; display: grid; gap: .35rem; font-size: .8rem; }
  .home-meta span { color: var(--muted); }
  .home-meta strong { font-weight: 600; }
  .home-portrait-wrap { position: relative; width: 100%; max-width: 380px; box-sizing: border-box; margin: auto; padding: 1.1rem 1.1rem 2.6rem; background: var(--acid); transform: rotate(2deg); }
  .portrait-frame { aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface); }
  .home-portrait { width: 100%; height: 100%; object-fit: cover; }
  .portrait-index { position: absolute; bottom: .9rem; left: 1.15rem; color: #171b16; letter-spacing: .08em; }
  .portrait-index b { margin-left: .6rem; }
  .portrait-stamp { position: absolute; right: -1.25rem; top: 1.6rem; display: grid; place-items: center; width: 3.8rem; height: 3.8rem; border: 1px solid var(--ink); border-radius: 50%; background: var(--paper); color: var(--ink); font-family: ui-monospace, monospace; font-weight: 800; }
  .portrait-stamp span { color: var(--olive); }
  .home-section { padding: clamp(3.5rem, 8vw, 6.5rem) 0; border-top: 1px solid var(--line); }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 2rem; }
  .section-heading h2, .home-contact h2 { margin: .5rem 0 0; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1.05; letter-spacing: -.055em; }
  .publication-list { border-top: 1px solid var(--line); }
  .publication-row { display: grid; grid-template-columns: 3.5rem 1fr auto; gap: 1rem; align-items: center; padding: 1.2rem .25rem; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .publication-row:hover strong, .publication-row:hover .publication-arrow { color: var(--olive); }
  .publication-number { color: var(--muted); font: .75rem ui-monospace, monospace; }
  .publication-row strong, .publication-row small { display: block; }
  .publication-row strong { font-size: 1.08rem; }
  .publication-row small { margin-top: .35rem; color: var(--muted); }
  .publication-arrow { font-size: 1.25rem; }
  .home-contact { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin: 2rem 0 4rem; padding: clamp(2rem, 6vw, 4rem); border: 1px solid var(--line); background-size: 24px 24px; }
  @media (max-width: 760px) { .home-hero { grid-template-columns: 1fr; gap: 2.5rem; padding-top: 2rem; } .home-portrait-wrap { width: min(82%, 360px); } .section-heading { align-items: start; } .home-contact { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 480px) { .home-copy h1 { font-size: clamp(2.7rem, 12vw, 3.5rem); } .home-actions { display: grid; grid-template-columns: minmax(0, 1fr); gap: .75rem; } .home-actions .button-primary, .home-actions .button-text { width: 100%; min-height: 3.25rem; justify-content: space-between; padding: .9rem 1.1rem; } .home-actions .button-text { border: 1px solid var(--line); } .publication-row { grid-template-columns: 2rem minmax(0, 1fr) auto; gap: .65rem; } }
</style>
