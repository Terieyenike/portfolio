---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Page not found | ${SITE_TITLE}`} description={SITE_DESCRIPTION} noIndex={true}>
  <main class="not-found mx-auto grid min-h-[65vh] max-w-6xl items-center gap-8 px-4 py-12 sm:px-6 md:grid-cols-[1fr_auto]">
    <div><p class="site-kicker text-[var(--olive)]">404 / Wrong turn</p><h1>There’s nothing here.<br /><em>Yet.</em></h1><p class="not-found-copy">The page may have moved, or the address may have a typo. Let’s get you back to the useful stuff.</p><div class="not-found-links"><a href="/" class="not-found-primary">Go to homepage ↗</a><a href="/projects/">Browse projects →</a></div></div>
    <div class="not-found-mark" aria-hidden="true"><span>404</span><i>TE.</i></div>
  </main>
</BaseLayout>

<style>
  .not-found h1 { margin: 1rem 0; font-size: clamp(3.5rem, 8vw, 7rem); line-height: .95; letter-spacing: -.075em; }
  .not-found h1 em { color: var(--olive); font-family: Georgia, serif; font-weight: 400; }
  .not-found-copy { max-width: 34rem; color: var(--muted); font-size: 1.1rem; line-height: 1.7; }
  .not-found-links { display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center; margin-top: 1.75rem; }
  .not-found-links a { color: var(--ink); font-weight: 650; text-underline-offset: .25rem; }
  .not-found-links a:hover { color: var(--olive); }
  .not-found-links .not-found-primary { padding: .9rem 1.1rem; background: var(--ink); color: var(--paper); text-decoration: none; }
  .not-found-mark { display: grid; place-items: center; position: relative; width: min(32vw, 16rem); aspect-ratio: 1; border: 1px solid var(--line); border-radius: 50%; background: var(--acid); color: #171b16; }
  .not-found-mark span { font: 700 clamp(3rem, 8vw, 6rem) ui-monospace, monospace; letter-spacing: -.12em; }
  .not-found-mark i { position: absolute; right: 1rem; bottom: 1rem; font: 700 .8rem ui-monospace, monospace; }
  @media(max-width: 767px) { .not-found-mark { width: 8rem; justify-self: end; } }
</style>
