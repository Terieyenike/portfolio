---
import { type CollectionEntry, getCollection } from "astro:content";
import Prose from "../components/Prose.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import FormattedDate from "../components/FormattedDate.astro";
import Author from "../components/Author.astro";
import TableOfContent from "../components/widgets/TableOfContent.astro";
import TLDR from "../components/widgets/TLDR.astro";
import { slugify, calculateReadingTime } from "../utils";
import { loadEnv } from "vite";

const { GISCUS_REPO, GISCUS_REPO_ID, GISCUS_CATEGORY, GISCUS_CATEGORY_ID } =
  loadEnv(process.env.NODE_ENV || "production", process.cwd(), "");

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post: any) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;
const post = Astro.props;
const {
  data: {
    title,
    seoTitle,
    description,
    coverImage,
    pubDate,
    updatedDate,
    tags,
    tldr,
    canonicalUrl,
  },
} = post;
const { Content, headings } = await post.render();
const readingTime = calculateReadingTime(post.body);
const articleUrl = canonicalUrl
  ? new URL(canonicalUrl).href
  : new URL(`/${post.slug}/`, Astro.site!).href;
const articleSchema = {
  "@type": "BlogPosting",
  "@id": `${articleUrl}#article`,
  headline: title,
  description,
  ...(coverImage ? { image: [new URL(coverImage.src, Astro.site!).href] } : {}),
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: { "@id": `${new URL("/", Astro.site!).href}#person` },
  publisher: { "@id": `${new URL("/", Astro.site!).href}#person` },
  mainEntityOfPage: { "@id": articleUrl },
  ...(tags?.length ? { keywords: tags.join(", "), articleSection: tags } : {}),
};
---

<BaseLayout
  title={seoTitle || title}
  description={description}
  image={coverImage?.src || undefined}
  canonicalUrl={canonicalUrl}
  pageSchema={articleSchema}
  pageType="article"
>
  <div class="article-layout">
    <main class="article-main min-w-0">
      <article>
        <a class="article-back" href="/blog/"><span aria-hidden="true">←</span> All articles</a>
        <Prose>
          <div>
            <p class="article-eyebrow">FIELD NOTES <span aria-hidden="true">/</span> {pubDate.getFullYear()}</p>
            <h1 class="article-title !my-1 leading-tight">{title}</h1>

            <!-- Post metadata -->
            <div
              class="flex flex-wrap items-center justify-between gap-4 mt-4 mb-6"
            >
              <!-- Left side: Tags -->
              <div class="flex flex-wrap gap-2">
                {
                  (tags || [])?.map((tag: string) => (
                    <a
                      class="inline-flex px-3 py-1 text-sm bg-zinc-100 dark:bg-zinc-800 
                    text-zinc-600 dark:text-zinc-400 rounded-full no-underline 
                    hover:bg-[#506814] dark:hover:bg-[#D8F16A] hover:text-white 
                    dark:hover:text-zinc-900 transition-all duration-300"
                      href={`/tags/${slugify(tag)}`}
                    >
                      {tag}
                    </a>
                  ))
                }
              </div>

              <!-- Right side: Reading time and dates -->
              <div
                class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-zinc-600 dark:text-zinc-400"
              >
                <div
                  class="inline-flex items-center gap-1.5 px-3 py-1 bg-zinc-100 dark:bg-zinc-800 rounded-full"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-[#506814] dark:text-[#D8F16A]"
                  >
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <span>{readingTime} min read</span>
                </div>
                <span>Posted on <FormattedDate date={pubDate} /></span>
                {
                  updatedDate && (
                    <span>
                      Updated on <FormattedDate date={updatedDate} />
                    </span>
                  )
                }
              </div>
            </div>

            <div class="article-author-line">
              <Author picSize="sm" />
            </div>

            {headings.length > 0 && <details class="article-mobile-toc">
              <summary>On this page <span aria-hidden="true">＋</span></summary>
              <nav aria-label="Article contents"><ul>
                {headings.filter((heading) => heading.depth === 2 || heading.depth === 3).map((heading) => <li class:list={{ "article-mobile-toc-subheading": heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
              </ul></nav>
            </details>}

            <!-- Canonical URL -->
            {
              canonicalUrl && (
                <div class="text-sm text-zinc-600 dark:text-zinc-400 mb-6">
                  Originally published at{" "}
                  <a
                    href={canonicalUrl}
                    class="text-[#506814] dark:text-[#D8F16A] no-underline hover:opacity-80 transition-opacity"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {new URL(canonicalUrl).hostname}
                  </a>
                </div>
              )
            }

            <!-- Cover Image -->
            {
              coverImage && (
                <div class="article-cover mb-6">
                  <Image
                    class="rounded-2xl w-full"
                    src={coverImage}
                    alt={title}
                    loading="eager"
                  />
                </div>
              )
            }

            <!-- Content -->
            <TLDR summary={tldr} />
            <Content />
            <div class="article-end not-prose">
              <a href="/blog/">Browse all articles <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </Prose>

        <!-- Comments -->
        {
          GISCUS_REPO && (
            <script
              id="giscus-script"
              is:inline
              src="https://giscus.app/client.js"
              data-repo={GISCUS_REPO}
              data-repo-id={GISCUS_REPO_ID}
              data-category={GISCUS_CATEGORY}
              data-category-id={GISCUS_CATEGORY_ID}
              data-mapping="pathname"
              data-strict="0"
              data-reactions-enabled="1"
              data-emit-metadata="0"
              data-input-position="bottom"
              data-theme="preferred_color_scheme"
              data-lang="en"
              crossorigin="anonymous"
              async
            />
          )
        }
      </article>
    </main>

    <aside class="article-sidebar hidden lg:block" aria-label="Article navigation">
      <TableOfContent headings={headings} />
    </aside>
  </div>
</BaseLayout>

<!-- Copy-to-Clipboard for Code Blocks (Blog Posts Only) -->
<script is:inline>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('article pre > code').forEach(function (codeBlock) {
    const pre = codeBlock.parentNode;
    // Prevent duplicate buttons
    if (pre.querySelector('.copy-btn')) return;
    // Create button
    const button = document.createElement('button');
    button.className = 'copy-btn';
    button.type = 'button';
    button.title = 'Copy code';
    button.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
    button.style.position = 'absolute';
    button.style.top = '10px';
    button.style.right = '10px';
    button.style.zIndex = '10';
    // Wrap pre in relative div if not already
    if (pre.parentNode.className !== 'pre-wrapper') {
      const wrapper = document.createElement('div');
      wrapper.className = 'pre-wrapper';
      wrapper.style.position = 'relative';
      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);
    }
    pre.parentNode.appendChild(button);
    button.addEventListener('click', function () {
      navigator.clipboard.writeText(codeBlock.innerText).then(() => {
        button.innerHTML = 'Copied!';
        setTimeout(() => {
          button.innerHTML = `<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg>`;
        }, 1200);
      });
    });
  });
});
</script>

<style>
.article-layout { display: grid; width: min(100% - 2rem, 80rem); grid-template-columns: minmax(0, 52rem) minmax(12rem, 15rem); align-items: start; justify-content: center; gap: clamp(2.5rem, 5vw, 5rem); margin: 0 auto; }
.article-main { min-width: 0; }
.article-back { display: inline-flex; min-height: 44px; align-items: center; gap: .5rem; margin: 0 0 1rem; color: var(--muted); font-size: .9rem; font-weight: 650; text-decoration: none; }
.article-back:hover { color: var(--ink); }
.article-main :global(.prose) { max-width: none; color: var(--ink); font-size: 1.04rem; line-height: 1.8; }
.article-main :global(.prose h1.article-title) { max-width: 19ch; margin: .25rem 0 1.35rem; color: var(--ink); font-size: clamp(2.35rem, 4.8vw, 4.15rem); font-weight: 800; line-height: 1.04; letter-spacing: -.06em; text-wrap: balance; }
.article-eyebrow { margin: 0 0 .8rem !important; color: var(--olive); font: 700 .7rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace !important; letter-spacing: .14em; text-transform: uppercase; }
.article-eyebrow span { padding: 0 .25rem; color: var(--muted); }
.article-main :global(.prose > div > .flex.flex-wrap.items-center.justify-between) { justify-content: flex-start; gap: .75rem 1.25rem; margin: 1.25rem 0 1rem; }
.article-author-line { margin: 1.1rem 0 1.5rem; padding: .9rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.article-author-line :global(.flex.gap-4) { gap: .75rem; }
.article-author-line :global(.w-12.h-12) { width: 2.75rem; height: 2.75rem; }
.article-author-line :global(.avatar__subtitle) { color: var(--muted); font-size: .75rem; }
.article-sidebar { min-width: 0; align-self: stretch; padding-top: 5rem; }
.article-sidebar :global(.toc) { position: sticky; top: 5rem; margin: 0; padding: .75rem 0; }
.article-sidebar :global(.toc h3) { margin-bottom: .6rem; padding-left: .75rem; color: var(--muted); font-size: .68rem; letter-spacing: .12em; }
.article-sidebar :global(.toc-list) { max-height: calc(100vh - 8rem); }
.article-main :global(.article-mobile-toc) { display: none; }
.article-main :global(.article-cover) { margin: 0 0 2rem; }
.article-main :global(.article-cover img) { display: block; width: 100%; max-height: 34rem; margin: 0; border-radius: 1rem; object-fit: contain; }
.article-main :global(.article-end) { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 1.5rem; margin: 3rem 0 2rem; padding: 1rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.article-main :global(.article-end a) { color: var(--ink); font-size: .9rem; font-weight: 700; text-decoration-color: var(--olive); text-underline-offset: .25em; }
.article-main :global(.article-end a:hover) { color: var(--olive); }
.pre-wrapper { position: relative; }
.copy-btn {
  position: absolute;
  top: 10px;
  right: 10px;
  background: #222;
  color: #fff;
  border: none;
  border-radius: 4px;
  padding: 4px 8px;
  cursor: pointer;
  opacity: 0.7;
  transition: opacity 0.2s;
  font-size: 0.9em;
  display: flex;
  align-items: center;
}
.copy-btn:hover, .copy-btn:focus {
  opacity: 1;
  background: #506814;
  color: #fff;
}
article pre { position: relative; }
@media(max-width: 1140px) {
  .article-layout { width: min(100% - 2rem, 52rem); grid-template-columns: minmax(0, 1fr); }
  .article-sidebar { display: none; }
  .article-main :global(.prose > div > .article-mobile-toc) { display: block; margin: 1.5rem 0; border: 1px solid var(--line); background: var(--surface); }
  .article-main :global(.article-mobile-toc summary) { display: flex; min-height: 48px; align-items: center; justify-content: space-between; padding: .7rem .9rem; color: var(--ink); font-size: .9rem; font-weight: 700; cursor: pointer; list-style: none; }
  .article-main :global(.article-mobile-toc summary::-webkit-details-marker) { display: none; }
  .article-main :global(.article-mobile-toc[open] summary span) { transform: rotate(45deg); }
  .article-main :global(.article-mobile-toc nav) { padding: 0 .9rem .8rem; }
  .article-main :global(.article-mobile-toc ul) { display: grid; gap: .15rem; margin: 0; padding: 0; list-style: none; }
  .article-main :global(.article-mobile-toc a) { display: block; padding: .35rem 0; color: var(--muted); font-size: .86rem; text-decoration: none; }
  .article-main :global(.article-mobile-toc a:hover) { color: var(--ink); text-decoration: underline; text-decoration-color: var(--olive); }
  .article-main :global(.article-mobile-toc-subheading) { padding-left: .9rem; }
}
@media(max-width: 600px) {
  .article-layout { width: min(100% - 1.5rem, 52rem); }
  .article-main :global(.prose h1.article-title) { font-size: clamp(2.1rem, 10vw, 3.25rem); }
  .article-main :global(.prose > div > .flex.flex-wrap.items-center.justify-between) { align-items: flex-start; }
  .article-main :global(.prose > div > .flex.flex-wrap.items-center.justify-between > div:last-child) { justify-content: flex-start; }
  .article-main :global(.article-cover img) { max-height: 24rem; }
}
</style>
