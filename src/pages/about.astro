---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Teri from "@src/assets/img/profile.png";
---

<BaseLayout title="About | Teri Eyenike" description="Meet Teri Eyenike: software and DevOps engineer building useful tools, cloud workflows, and practical technical writing.">
  <main class="about-page mx-auto max-w-6xl px-4 sm:px-6">
    <header class="about-hero">
      <div><p class="site-kicker text-[var(--olive)]">A little context / 01</p><h1>Curious about how things work. Serious about making them <em>work better.</em></h1><p class="about-lede">I’m Teri Eyenike, a software and DevOps engineer in Nigeria. I enjoy turning tricky technical problems into tools, workflows, and explanations people can actually use.</p><div class="about-actions"><a class="about-primary" href="/projects/">See what I’ve built ↗</a><a class="about-link" href="/resume/">View résumé draft →</a></div></div>
      <figure class="about-photo"><Image src={Teri} alt="Portrait of Teri Eyenike" width={480} loading="eager" /><figcaption class="site-kicker">Teri Eyenike · Engineer &amp; writer</figcaption></figure>
    </header>
    <section class="about-section"><p class="site-kicker text-[var(--olive)]">The work / 02</p><h2>Where I spend my attention</h2><div class="focus-grid">
      <article><span class="focus-number">01</span><h3>Software that helps</h3><p>Building useful applications and developer tools with an emphasis on clear interfaces, maintainable code, and solving a real problem.</p></article>
      <article><span class="focus-number">02</span><h3>Reliable systems</h3><p>Working across cloud infrastructure, automation, and DevOps practices to make software easier to ship and operate.</p></article>
      <article><span class="focus-number">03</span><h3>Knowledge shared</h3><p>Writing practical technical guides that make tools and concepts easier to understand, try, and apply.</p></article>
    </div></section>
    <section class="about-section toolkit"><div><p class="site-kicker text-[var(--olive)]">Tools I use / 03</p><h2>A practical toolkit</h2></div><ul>{['Python', 'JavaScript', 'AWS', 'Git', 'Node.js', 'PostgreSQL', 'OpenAI'].map((technology) => <li>{technology}</li>)}</ul></section>
    <section class="about-contact site-grid-pattern"><div><p class="site-kicker text-[var(--olive)]">The next chapter / 04</p><h2>Have a challenge worth solving?</h2><p>I’m open to thoughtful collaborations, interesting engineering problems, and conversations about building better software.</p></div><a class="about-primary" href="/contact/">Get in touch ↗</a></section>
  </main>
</BaseLayout>

<style>
  .about-page { padding-top: 1rem; }
  .about-hero { display: grid; grid-template-columns: 1.2fr .8fr; align-items: center; gap: clamp(3rem, 8vw, 8rem); padding: clamp(2rem, 7vw, 6rem) 0; }
  .about-hero h1 { margin: 1.25rem 0; font-size: clamp(3rem, 6vw, 5.8rem); line-height: 1; letter-spacing: -.07em; }
  .about-hero h1 em { color: var(--olive); font-family: Georgia, serif; font-weight: 400; }
  .about-lede { max-width: 40rem; color: var(--muted); font-size: 1.15rem; line-height: 1.8; }
  .about-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 2rem; }
  .about-primary, .about-link { display: inline-flex; align-items: center; padding: .9rem 1.1rem; text-decoration: none; font-weight: 650; }
  .about-primary { background: var(--ink); color: var(--paper); }
  .about-primary:hover { background: var(--olive); color: white; }
  .about-link { color: var(--ink); border-bottom: 1px solid var(--line); }
  .about-photo { margin: 0; padding: .8rem .8rem 1rem; background: var(--acid); transform: rotate(-2deg); }
  .about-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .about-photo figcaption { padding: .8rem .25rem 0; color: #171b16; font-size: .63rem; }
  .about-section { border-top: 1px solid var(--line); padding: clamp(3rem, 7vw, 5.5rem) 0; }
  .about-section h2, .about-contact h2 { margin: .6rem 0 2rem; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.05; letter-spacing: -.055em; }
  .focus-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .focus-grid article { padding: 1.5rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .focus-number { color: var(--olive); font: .78rem ui-monospace, monospace; }
  .focus-grid h3 { margin: 2rem 0 .5rem; font-size: 1.2rem; }
  .focus-grid p, .about-contact p:not(.site-kicker) { color: var(--muted); line-height: 1.7; }
  .toolkit { display: grid; grid-template-columns: .8fr 1.2fr; align-items: start; gap: 2rem; }
  .toolkit h2 { margin-bottom: 0; }
  .toolkit ul { display: flex; flex-wrap: wrap; gap: .6rem; margin: 0; padding: 0; list-style: none; }
  .toolkit li { border: 1px solid var(--line); padding: .65rem .9rem; font-size: .9rem; }
  .about-contact { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin: 0 0 3rem; padding: clamp(2rem, 6vw, 4rem); border: 1px solid var(--line); background-size: 24px 24px; }
  .about-contact h2 { margin-bottom: .8rem; }
  .about-contact p:not(.site-kicker) { max-width: 36rem; margin: 0; }
  @media(max-width: 760px) { .about-hero, .toolkit { grid-template-columns: 1fr; } .about-photo { width: min(80%, 340px); margin: 0 auto; } .focus-grid { grid-template-columns: 1fr; } .focus-grid h3 { margin-top: 1rem; } .about-contact { align-items: flex-start; flex-direction: column; } }
</style>
