---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Teri from "@src/assets/img/profile.png";
import { SITE_TITLE } from "../consts";
import { talks } from "../data/resume";

const aboutDescription = "Learn about Teri Eyenike, a software engineer and developer advocate in Nigeria who builds web applications, developer tools, and practical technical content.";
const aboutUrl = new URL("/about/", Astro.site!).href;
const profileSchema = {
  "@type": "ProfilePage",
  "@id": `${aboutUrl}#profile`,
  url: aboutUrl,
  name: `About ${SITE_TITLE}`,
  description: aboutDescription,
  mainEntity: { "@id": `${new URL("/", Astro.site!).href}#person` },
};
---

<BaseLayout title="About Teri Eyenike | Software Engineer & Developer Advocate" description={aboutDescription} pageSchema={profileSchema}>
  <main class="about-page mx-auto max-w-6xl px-4 sm:px-6">
    <header class="about-hero">
      <div><p class="site-kicker text-[var(--olive)]">A little context / 01</p><h1>Curious about how things work. Serious about making them <em>work better.</em></h1><p class="about-lede">I’m Teri Eyenike, a software engineer and developer advocate in Nigeria. I build web applications and developer tools, then share practical technical knowledge that helps people understand and use them.</p><div class="about-actions"><a class="about-primary" href="/projects/">See what I’ve built ↗</a><a class="about-link" href="/resume/">View résumé →</a></div></div>
      <figure class="about-photo"><Image src={Teri} alt="Portrait of Teri Eyenike" width={480} loading="eager" /><figcaption class="site-kicker">Teri Eyenike · Engineer &amp; writer</figcaption></figure>
    </header>
    <section class="about-section"><p class="site-kicker text-[var(--olive)]">The work / 02</p><h2>Where I spend my attention</h2><div class="focus-grid">
      <article><span class="focus-number">01</span><h3>Software that helps</h3><p>Building useful applications and developer tools with an emphasis on clear interfaces, maintainable code, and solving a real problem.</p></article>
      <article><span class="focus-number">02</span><h3>Knowledge shared</h3><p>Writing practical technical guides that make tools and concepts easier to understand, try, and apply.</p></article>
    </div></section>
    <section class="about-section speaking" aria-labelledby="speaking-title">
      <div><p class="site-kicker text-[var(--olive)]">Speaking / 03</p><h2 id="speaking-title">Sharing what I learn</h2></div>
      {talks.map((talk) => <article class="talk-card">
        <p class="talk-meta">{talk.organization} <span aria-hidden="true">·</span> {talk.date}</p>
        <h3>{talk.title}</h3>
        <p>{talk.description}</p>
        <a href={talk.url} target="_blank" rel="noopener noreferrer">Watch the talk <span aria-hidden="true">↗</span></a>
      </article>)}
    </section>
    <section class="about-section toolkit"><div><p class="site-kicker text-[var(--olive)]">Tools I use / 04</p><h2>A practical toolkit</h2></div><ul>{['Python', 'JavaScript', 'AWS', 'Git', 'Node.js', 'PostgreSQL', 'OpenAI', 'Codex', 'Claude'].map((technology) => <li>{technology}</li>)}</ul></section>
    <section class="about-contact site-grid-pattern"><div><p class="site-kicker text-[var(--olive)]">The next chapter / 05</p><h2>Have a challenge worth solving?</h2><p>I’m open to software engineering roles and collaborations in technical writing, consulting, and building company web pages.</p></div><a class="about-primary" href="/contact/">Discuss a role or project ↗</a></section>
  </main>
</BaseLayout>

<style>
  .about-page { padding-top: 1rem; }
  .about-hero { display: grid; grid-template-columns: 1.2fr .8fr; align-items: center; gap: clamp(3rem, 8vw, 8rem); padding: clamp(2rem, 7vw, 6rem) 0; }
  .about-hero h1 { margin: 1.25rem 0; font-size: clamp(3rem, 6vw, 5.8rem); line-height: 1; letter-spacing: -.07em; }
  .about-hero h1 em { color: var(--olive); font-family: Georgia, serif; font-weight: 400; }
  .about-lede { max-width: 40rem; color: var(--muted); font-size: 1.15rem; line-height: 1.8; }
  .about-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 2rem; }
  .about-primary, .about-link { display: inline-flex; align-items: center; padding: .9rem 1.1rem; text-decoration: none; font-weight: 650; }
  .about-primary { background: var(--ink); color: var(--paper); }
  .about-primary:hover { background: var(--acid); color: #171b16; }
  .about-link { color: var(--ink); border-bottom: 1px solid var(--line); }
  .about-photo { margin: 0; padding: .8rem .8rem 1rem; background: var(--acid); transform: rotate(-2deg); }
  .about-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .about-photo figcaption { padding: .8rem .25rem 0; color: #171b16; font-size: .63rem; }
  .about-section { border-top: 1px solid var(--line); padding: clamp(3rem, 7vw, 5.5rem) 0; }
  .about-section h2, .about-contact h2 { margin: .6rem 0 2rem; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.05; letter-spacing: -.055em; }
  .focus-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .focus-grid article { padding: 1.5rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .focus-number { color: var(--olive); font: .78rem ui-monospace, monospace; }
  .focus-grid h3 { margin: 2rem 0 .5rem; font-size: 1.2rem; }
  .focus-grid p, .about-contact p:not(.site-kicker) { color: var(--muted); line-height: 1.7; }
  .speaking { display: grid; grid-template-columns: .8fr 1.2fr; align-items: start; gap: 2rem; }
  .speaking h2 { max-width: 18rem; }
  .talk-card { border: 1px solid var(--line); padding: clamp(1.25rem, 3vw, 2rem); }
  .talk-meta { margin: 0 0 1rem; color: var(--olive); font: .75rem ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .talk-card h3 { max-width: 38rem; margin: 0; font-size: clamp(1.35rem, 2.8vw, 2rem); line-height: 1.2; letter-spacing: -.035em; }
  .talk-card > p:not(.talk-meta) { color: var(--muted); line-height: 1.7; }
  .talk-card a { display: inline-flex; gap: .5rem; align-items: center; margin-top: .5rem; color: var(--ink); font-weight: 650; text-decoration: underline; text-decoration-color: var(--olive); text-underline-offset: .25em; }
  .talk-card a:hover { color: var(--olive); }
  .toolkit { display: grid; grid-template-columns: .8fr 1.2fr; align-items: start; gap: 2rem; }
  .toolkit h2 { margin-bottom: 0; }
  .toolkit ul { display: flex; min-width: 0; flex-wrap: wrap; gap: .6rem; margin: 0; padding: 0; list-style: none; }
  .toolkit li { max-width: 100%; overflow-wrap: anywhere; border: 1px solid var(--line); padding: .65rem .9rem; font-size: .9rem; }
  .about-contact { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin: 0 0 3rem; padding: clamp(2rem, 6vw, 4rem); border: 1px solid var(--line); background-size: 24px 24px; }
  .about-contact h2 { margin-bottom: .8rem; }
  .about-contact p:not(.site-kicker) { max-width: 36rem; margin: 0; }
  @media(max-width: 760px) { .about-hero, .toolkit, .speaking { grid-template-columns: 1fr; } .about-photo { width: min(80%, 340px); margin: 0 auto; } .focus-grid { grid-template-columns: 1fr; } .focus-grid h3 { margin-top: 1rem; } .about-contact { align-items: flex-start; flex-direction: column; } }
  @media(max-width: 480px) { .about-hero h1 { font-size: clamp(2.6rem, 11.5vw, 3.5rem); } }
</style>
