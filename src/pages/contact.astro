---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../consts";

const emailAddress = "developedbyteri@gmail.com";
const mailtoUrl = `mailto:${emailAddress}?subject=${encodeURIComponent("Inquiry about working together")}`;
---

<BaseLayout
  title={`Contact ${SITE_TITLE} | Software Engineer`}
  description="Get in touch with Teri Eyenike about software engineering roles, web projects, technical writing, and consulting."
>
  <main class="site-shell">
    <section class="relative isolate overflow-hidden py-12 sm:py-16 lg:py-20">
      <div aria-hidden="true" class="pointer-events-none absolute -right-32 -top-24 -z-10 h-96 w-96 rounded-full bg-[#D8F16A]/20 blur-3xl dark:bg-[#D8F16A]/10"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-32 -left-28 -z-10 h-80 w-80 rounded-full bg-[#506814]/10 blur-3xl"></div>

      <div class="container mx-auto grid max-w-5xl gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_0.9fr] lg:items-center lg:gap-16">
        <div class="pt-2">
          <p class="site-kicker mb-5 text-[var(--olive)]">Contact · Nigeria · WAT</p>
          <h1 class="mb-6 max-w-xl text-4xl font-semibold leading-[1.08] tracking-tight text-[var(--ink)] sm:text-5xl lg:text-6xl">
            Let’s make the next thing matter.
          </h1>
          <p class="max-w-lg text-lg leading-8 text-[var(--muted)] sm:text-xl">
            Tell me what you’re working on. I’m open to software engineering roles, web projects, technical writing, and thoughtful collaborations.
          </p>
        </div>

        <div class="site-panel rounded-2xl p-6 shadow-xl shadow-[#171b16]/5 sm:p-8 lg:p-10">
          <div aria-hidden="true" class="mb-8 grid h-14 w-14 place-items-center rounded-2xl bg-[#506814]/10 text-[var(--olive)] dark:bg-[#D8F16A]/10">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none"><path d="M3.75 6.75A2.25 2.25 0 0 1 6 4.5h12a2.25 2.25 0 0 1 2.25 2.25v10.5A2.25 2.25 0 0 1 18 19.5H6a2.25 2.25 0 0 1-2.25-2.25V6.75Z" stroke="currentColor" stroke-width="1.6"/><path d="m4.5 6 7.5 6 7.5-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h2 class="mb-6 text-2xl font-semibold tracking-tight text-[var(--ink)] sm:text-3xl">Send me a note</h2>
          <a
            href={mailtoUrl}
            class="inline-flex min-h-12 w-full items-center justify-center gap-3 rounded-xl bg-[#506814] px-5 py-3 text-center font-semibold text-white transition-colors hover:bg-[#3e5110] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#506814] dark:bg-[#D8F16A] dark:text-zinc-900 dark:hover:bg-[#c4de4f] dark:focus-visible:outline-[#D8F16A]"
          >
            {emailAddress}
            <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="none"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
