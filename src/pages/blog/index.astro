---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostsByYear from "../../components/PostsByYear.astro";

type BlogPost = CollectionEntry<"blog">;
const title = "Writing";
const description =
  "Practical articles and tutorials on software engineering, AI, cloud, and DevOps.";

const posts = (await getCollection("blog")).sort(
  (a: BlogPost, b: BlogPost) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title={title} description={description}>
  <main class="container mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <header class="mb-10">
      <p class="site-kicker mb-2 text-[var(--olive)]">Ideas &amp; tutorials / Archive</p>
      <h1 class="text-5xl font-semibold tracking-tight text-[var(--ink)] sm:text-6xl">{title}</h1>
      <p class="mt-3 text-lg leading-8 text-[var(--muted)]">{description}</p>
      <a href="/tags/" class="mt-4 inline-flex text-sm font-semibold text-[var(--olive)] underline underline-offset-4">Browse by topic →</a>
    </header>
    
    <div class="site-panel p-5 sm:p-7">
      <PostsByYear posts={posts} />
    </div>
  </main>
</BaseLayout>
