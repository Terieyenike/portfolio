---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostsByYear from "../../components/PostsByYear.astro";

type BlogPost = CollectionEntry<"blog">;
const pageTitle = "Software Articles & Tutorials | Teri Eyenike";
const heading = "Software Articles & Tutorials";
const description = "Practical guides and notes on JavaScript, Python, AWS, AI tools, PostgreSQL, and developer workflows.";

const posts = (await getCollection("blog")).sort(
  (a: BlogPost, b: BlogPost) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title={pageTitle} description={description}>
  <main class="container mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <header class="mb-10">
      <p class="site-kicker mb-2 text-[var(--olive)]">Ideas &amp; tutorials / Archive</p>
      <h1 class="max-w-[18ch] text-[clamp(2.5rem,7vw,4rem)] font-semibold leading-[1.05] tracking-tight text-[var(--ink)]">{heading}</h1>
      <p class="mt-4 max-w-[62ch] text-base leading-relaxed text-[var(--muted)] sm:text-lg">{description}</p>
      <a href="/tags/" class="mt-4 inline-flex text-sm font-semibold text-[var(--olive)] underline underline-offset-4">Browse by topic →</a>
    </header>
    
    <div class="site-panel p-5 sm:p-7">
      <PostsByYear posts={posts} />
    </div>
  </main>
</BaseLayout>
