---
import type { Project } from '../pages/projects/projects'

const { projects } = Astro.props
---

<div class="project-grid">
  {projects.map((project: Project, index: number) => (
    <article class="project-card">
      <div class="project-topline"><span class="project-number">0{index + 1} / SELECTED WORK</span><span aria-hidden="true">↗</span></div>
      <div class="project-tags">{(project.tags || []).map((tag) => <span>{tag}</span>)}</div>
      <h3>{project.name}</h3>
      <p class="project-description">{project.description}</p>
      {project.outcome && <p class="project-outcome"><strong>Outcome</strong>{project.outcome}</p>}
      <div class="project-links">
        {project.demoLink && <a href={project.demoLink} target="_blank" rel="noopener noreferrer">View project <span aria-hidden="true">↗</span></a>}
        {project.repositoryUrl && <a href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">Source <span aria-hidden="true">↗</span></a>}
        {project.serverRepositoryUrl && <a href={project.serverRepositoryUrl} target="_blank" rel="noopener noreferrer">Server source <span aria-hidden="true">↗</span></a>}
      </div>
    </article>
  ))}
</div>

<style>
  .project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .project-card { min-height: 19rem; display: flex; flex-direction: column; padding: 1.35rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--surface); transition: background-color .2s ease; }
  .project-card:hover { background: color-mix(in srgb, var(--acid) 13%, var(--surface)); }
  .project-topline { display: flex; justify-content: space-between; color: var(--muted); font: .68rem ui-monospace, monospace; letter-spacing: .08em; }
  .project-topline > span:last-child { color: var(--olive); font-size: 1.1rem; }
  .project-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 2.3rem; }
  .project-tags span { padding: .25rem .45rem; background: color-mix(in srgb, var(--acid) 45%, var(--surface)); color: var(--ink); font: .68rem ui-monospace, monospace; }
  .project-card h3 { margin: .8rem 0 .45rem; font-size: 1.3rem; letter-spacing: -.035em; }
  .project-description { margin: 0; color: var(--muted); line-height: 1.6; font-size: .9rem; }
  .project-outcome { display: grid; gap: .2rem; margin: .9rem 0 0; padding-left: .7rem; border-left: 2px solid var(--olive); color: var(--muted); font-size: .82rem; }
  .project-outcome strong { color: var(--ink); }
  .project-links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: auto; padding-top: 1.25rem; }
  .project-links a { display: inline-flex; min-height: 44px; align-items: center; color: var(--ink); font-size: .82rem; font-weight: 650; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: .25rem; }
  .project-links a:hover { color: var(--olive); text-decoration-color: var(--olive); }
  @media(max-width: 900px) { .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media(max-width: 600px) { .project-grid { grid-template-columns: 1fr; } .project-card { min-height: 16rem; } }
</style>
